<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base full-canvas vector background with diagonal linear gradient from top-left (obsidian slate) to bottom-right (vibrant midnight fusion) -->
    <path
        android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:color="#08090C"
                    android:offset="0.0" />
                <item
                    android:color="#0D0E15"
                    android:offset="0.5" />
                <item
                    android:color="#21041D"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle digital aesthetic alignment grid lines (translucent alpha) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.25"
        android:strokeAlpha="0.08"
        android:pathData="M18,0 v108 M36,0 v108 M54,0 v108 M72,0 v108 M90,0 v108 M0,18 h108 M0,36 h108 M0,54 h108 M0,72 h108 M0,90 h108" />

