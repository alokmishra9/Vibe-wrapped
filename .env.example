# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SPOTIFY_CLIENT_ID: Optional Spotify developer portal Client ID
# If not supplied, the app defaults to its built-in client ID which works out of the box.
SPOTIFY_CLIENT_ID=be7d363d33df45f3bfdf2cbf5fc1bd0a

# SPOTIFY_REDIRECT_URI: Optional redirect URI. Ensure it matches your Spotify developer setting.
SPOTIFY_REDIRECT_URI=https://localhost/callback
